{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Stackdome",
  "description": "Deploy, debug, and operate applications with coding agents, the Stackdome CLI, or the dashboard. Start on Stackdome Cloud or connect a self-hosted installation.",
  "favicon": {
    "light": "/favicon-32x32.png",
    "dark": "/favicon-32x32-dark.png"
