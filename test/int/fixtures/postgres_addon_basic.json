{
  "name": "test-postgres-basic",
  "spec": {
    "version": {
      "major": 16,
      "enable_auto_minor_upgrade": true
    },
    "instances": {
      "count": 1
    },
    "storage": {
      "size": "10Gi",
      "storage_class": "standard"
    },
    "resources": {
      "cpu": {
        "request": "250m",
        "limit": "1"
      },
      "memory": {
        "request": "512Mi",
        "limit": "2Gi"
      }
    },
    "databases": [
      {
        "name": "testapp",
        "extensions": []
      }
    ],
    "configuration": {
      "enable_superuser_access": false,
      "parameters": {
        "max_connections": "100",
        "shared_buffers": "128MB"
      }
    }
  }
}