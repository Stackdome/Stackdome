{
    "name": "infisical-with-build",
    "labels": [
        {
            "key": "environment",
            "value": "development"
        }
    ],
    "spec": {
        "stack_resources": [
            {
                "name": "backend",
                "build_spec": {
                    "context_path_within_source": "/",
                    "dockerfile_path": "/Dockerfile.standalone-infisical",
                    "image_repository": {
                        "use_internal_registry": true
                    },
                    "source_context": {
                        "git_repo": {
                            "repo_url": "https://github.com/Infisical/infisical.git"
                        }
                    },
                    "source_revision": {
                        "git_repo_revision": {
                            "branch": {
                                "name": "main"
                            }
                        }
                    }
                },
                "ports": [
                    {
                        "number": 8080,
                        "exposed_to_public": true,
                        "subdomain_prefix": "infisical-build",
                        "protocol": "HTTP"
                    }
                ],
                "execution_config": {
                    "environment_variables": [
                        {
                            "name": "NODE_ENV",
                            "value": "production"
                        },
                        {
                            "name": "ENCRYPTION_KEY",
                            "value": "6c1fe4e407b8911c104518103505b218"
                        },
                        {
                            "name": "AUTH_SECRET",
                            "value": "5lrMXKKWCVocS/uerPsl7V+TX/aaUaI7iDkgl3tSmLE="
                        },                        
                        {
                            "name": "POSTGRES_PASSWORD",
                            "value": "infisical"
                        },
                        {
                            "name": "POSTGRES_USER",
                            "value": "infisical"
                        },
                        {
                            "name": "POSTGRES_DB",
                            "value": "infisical"
                        },
                        {
                            "name": "DB_CONNECTION_URI",
                            "value": "postgres://infisical:infisical@{{STACKDOME_DB_INTERNAL}}:5432/infisical"
                        },
                        {
                            "name": "REDIS_URL",
                            "value": "redis://{{STACKDOME_REDIS_INTERNAL}}:6379"
                        },
                        {
                            "name": "SITE_URL",
                            "value": "http://localhost:8080"
                        },
                        {
                            "name": "ENABLE_MSSQL_SECRET_ROTATION_ENCRYPT",
                            "value": "true"
                        }
                    ]
                },
                "depends_on": ["db", "redis"]
            },
            {
                "name": "db",
                "image_spec": {
                    "image": "postgres:14-alpine"
                },
                "execution_config": {
                    "environment_variables": [                    
                        {
                            "name": "POSTGRES_PASSWORD",
                            "value": "infisical"
                        },
                        {
                            "name": "POSTGRES_USER",
                            "value": "infisical"
                        },
                        {
                            "name": "POSTGRES_DB",
                            "value": "infisical"
                        },
                        {
                            "name": "DB_CONNECTION_URI",
                            "value": "postgres://infisical:infisical@{{STACKDOME_DB_INTERNAL}}:5432/infisical"
                        }
                    ]
                },
                "ports": [
                    {
                        "number": 5432,
                        "exposed_to_public": false,
                        "protocol": "TCP"
                    }
                ],
                "volume_mounts": [
                    {
                        "source_volume_name": "db-volume",
                        "target_path": "/var/lib/postgresql/data"
                    }
                ]
            },
            {
                "name": "redis",
                "image_spec": {
                    "image": "redis:latest"
                },
                "execution_config": {
                    "environment_variables": [
                        {
                            "name": "REDIS_URL",
                            "value": "redis://{{STACKDOME_REDIS_INTERNAL}}:6379"
                        },
                        {
                            "name": "ALLOW_EMPTY_PASSWORD",
                            "value": "yes"
                        }
                    ]
                },
                "ports": [
                    {
                        "number": 6379,
                        "exposed_to_public": false,
                        "protocol": "TCP"
                    }
                ],
                "volume_mounts": [
                    {
                        "source_volume_name": "redis-volume",
                        "target_path": "/data"
                    }
                ]
            }
        ],
        "volumes": [
            {
                "name": "db-volume",
                "spec": {
                    "size": "1Gi",
                    "access_mode": "ReadWriteOnce",
                    "needs_sync_before_use": false
                }
            },
            {
                "name": "redis-volume",
                "spec": {
                    "size": "1Gi",
                    "access_mode": "ReadWriteOnce",
                    "needs_sync_before_use": false
                }
            }
        ]
    }
}