{
  "name": "postgres-migrated",
  "labels": [
    {
      "key": "migration",
      "value": "from-aws-rds"
    }
  ],
  "annotations": [
    {
      "key": "description",
      "value": "Database migrated from external AWS RDS instance"
    },
    {
      "key": "migration-date",
      "value": "2024-01-20"
    }
  ],
  "spec": {
    "version": {
      "major": 15,
      "enable_auto_minor_upgrade": true,
      "enable_auto_major_upgrade": true
    },
    "instances": {
      "count": 2
    },
    "storage": {
      "size": "500Gi",
      "storage_class": "gp3"
    },
    "resources": {
      "cpu": {
        "request": "4",
        "limit": "8"
      },
      "memory": {
        "request": "16Gi",
        "limit": "32Gi"
      }
    },
    "initialization": {
      "type": "import_from_external",
      "import_from_external": {
        "host": "myapp-prod.c9aksqd8fsog.us-west-2.rds.amazonaws.com",
        "port": 5432,
        "database": "production",
        "username": "postgres",
        "password_secret_id": "rds-migration-password-secret",
        "ssl_mode": "require",
        "databases_to_import": [
          "production",
          "analytics",
          "reporting"
        ]
      }
    },
    "backup": {
      "enabled": false,
      "object_store_id": "migration-backup-store",
      "schedule": "0 30 1 * * *",
      "wal_archiving": true
    },
    "databases": [
      {
        "name": "production",
        "extensions": ["vector"]
      },
      {
        "name": "analytics",
        "extensions": []
      },
      {
        "name": "reporting",
        "extensions": []
      }
    ],
    "configuration": {
      "enable_superuser_access": false,
      "parameters": {
        "max_connections": "1000",
        "shared_buffers": "8GB",
        "work_mem": "64MB",
        "maintenance_work_mem": "2GB",
        "effective_cache_size": "24GB",
        "checkpoint_segments": "32",
        "checkpoint_completion_target": "0.9",
        "wal_buffers": "32MB",
        "default_statistics_target": "100",
        "random_page_cost": "1.1"
      }
    }
  }
}