{
  "name": "tooljet-preview",
  "labels": [
    {
      "key": "app",
      "value": "tooljet"
    }
  ],
  "spec": {
    "stack_resources": [
      {
        "name": "tooljet",
        "workload_type": "StatefulService",
        "ports": [
          {
            "name": "http",
            "number": 80,
            "exposed_to_public": true,
            "subdomain_prefix": "tooljet",
            "protocol": "HTTP"
          }
        ],
        "execution_config": {
          "environment_variables": [
            {
              "name": "NODE_ENV",
              "value": "production"
            },
            {
              "name": "PORT",
              "value": "80"
            },
            {
              "name": "LOCKBOX_MASTER_KEY",
              "value": "db78c1536f072aa1607a89f3d29541134d132467f31579a51143f56b4ac84214"
            },
            {
              "name": "SECRET_KEY_BASE",
              "value": "0622a64434a91c4fefbd9658ff2212a43da7819ab153cc6b469de1275baba71a"
            },
            {
              "name": "PG_DB",
              "value": "tooljet_production"
            },
            {
              "name": "PG_USER",
              "value": "postgres"
            },
            {
              "name": "PG_PASS",
              "value": "postgres"
            },
            {
              "name": "ENABLE_TOOLJET_DB",
              "value": "true"
            },
            {
              "name": "TOOLJET_DB",
              "value": "tooljet_db"
            },
            {
              "name": "TOOLJET_DB_USER",
              "value": "postgres"
            },
            {
              "name": "TOOLJET_DB_PASS",
              "value": "postgres"
            },
            {
              "name": "PGRST_JWT_SECRET",
              "value": "r9iMKoe5CRMgvJBBtp4HrqN7QiPpUToj"
            },
            {
              "name": "PGRST_DB_PRE_CONFIG",
              "value": "postgrest.pre_config"
            },
            {
              "name": "NODE_OPTIONS",
              "value": "--max-old-space-size=4096"
            },
            {
              "name": "TOOLJET_HOST",
              "self_output": "public.http.url"
            }
          ]
        },
        "source": {
          "git": {
            "repo_url": "https://github.com/ToolJet/ToolJet.git",
            "branch": {
              "name": "lts-3.16"
            },
            "dockerfile_path": "/docker/ce-preview.Dockerfile",
            "build_context": "/"
          }
        }
      }
    ],
    "volumes": [
      {
        "name": "pg-data",
        "spec": {
          "size": "5Gi",
          "access_mode": "ReadWriteOnce",
          "needs_sync_before_use": false
        }
      }
    ],
    "connections": [
      {
        "kind": "volume_mount",
        "from": {
          "type": "volume",
          "name": "pg-data"
        },
        "to": {
          "type": "stack_resource",
          "name": "tooljet"
        },
        "config": {
          "mount_path": "/var/lib/postgresql"
        }
      }
    ]
  }
}
