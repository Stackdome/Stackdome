{
  "name": "tooljet",
  "labels": [
    {
      "key": "app",
      "value": "tooljet"
    }
  ],
  "spec": {
    "stack_resources": [
      {
        "name": "tooljet",
        "ports": [
          {
            "name": "http",
            "number": 80,
            "exposed_to_public": true,
            "subdomain_prefix": "tooljet",
            "protocol": "HTTP"
          }
        ],
        "execution_config": {
          "args": [
            "npm",
            "run",
            "start:prod"
          ],
          "environment_variables": [
            {
              "name": "NODE_ENV",
              "value": "production"
            },
            {
              "name": "PORT",
              "value": "80"
            },
            {
              "name": "LOCKBOX_MASTER_KEY",
              "value": "db78c1536f072aa1607a89f3d29541134d132467f31579a51143f56b4ac84214"
            },
            {
              "name": "SECRET_KEY_BASE",
              "value": "0622a64434a91c4fefbd9658ff2212a43da7819ab153cc6b469de1275baba71a"
            },
            {
              "name": "PG_PORT",
              "value": "5432"
            },
            {
              "name": "PG_USER",
              "value": "tooljet"
            },
            {
              "name": "PG_PASS",
              "value": "tooljet_password"
            },
            {
              "name": "PG_DB",
              "value": "tooljet"
            },
            {
              "name": "ENABLE_TOOLJET_DB",
              "value": "true"
            },
            {
              "name": "TOOLJET_DB",
              "value": "tooljet_db"
            },
            {
              "name": "TOOLJET_DB_USER",
              "value": "tooljet"
            },
            {
              "name": "TOOLJET_DB_PASS",
              "value": "tooljet_password"
            },
            {
              "name": "PGRST_HOST",
              "value": "localhost:3001"
            },
            {
              "name": "PGRST_SERVER_PORT",
              "value": "3001"
            },
            {
              "name": "PGRST_JWT_SECRET",
              "value": "0622a64434a91c4fefbd9658ff2212a43da7819ab153cc6b469de1275baba71a"
            },
            {
              "name": "SMTP_PORT",
              "value": "1025"
            },
            {
              "name": "SMTP_USERNAME",
              "value": "ashish"
            },
            {
              "name": "SMTP_PASSWORD",
              "value": "test"
            },
            {
              "name": "DEFAULT_FROM_EMAIL",
              "value": "tooljet@local.stackdome.io"
            },
            {
              "name": "TOOLJET_HOST",
              "self_output": "public.http.url"
            }
          ]
        },
        "depends_on": [
          "postgres",
          "redis"
        ],
        "source": {
          "image": {
            "ref": "tooljet/tooljet-ce:latest"
          }
        }
      },
      {
        "name": "postgres",
        "workload_type": "StatefulService",
        "ports": [
          {
            "name": "postgres",
            "number": 5432,
            "exposed_to_public": false,
            "protocol": "TCP"
          }
        ],
        "execution_config": {
          "environment_variables": [
            {
              "name": "POSTGRES_USER",
              "value": "tooljet"
            },
            {
              "name": "POSTGRES_PASSWORD",
              "value": "tooljet_password"
            },
            {
              "name": "POSTGRES_DB",
              "value": "tooljet"
            }
          ]
        },
        "source": {
          "image": {
            "ref": "postgres:13"
          }
        }
      },
      {
        "name": "redis",
        "ports": [
          {
            "name": "redis",
            "number": 6379,
            "exposed_to_public": false,
            "protocol": "TCP"
          }
        ],
        "source": {
          "image": {
            "ref": "redis:6.2"
          }
        }
      },
      {
        "name": "mailhog",
        "ports": [
          {
            "name": "smtp",
            "number": 1025,
            "exposed_to_public": false,
            "protocol": "TCP"
          },
          {
            "name": "http",
            "number": 8025,
            "exposed_to_public": true,
            "subdomain_prefix": "mail",
            "protocol": "HTTP"
          }
        ],
        "source": {
          "image": {
            "ref": "mailhog/mailhog"
          }
        }
      }
    ],
    "volumes": [
      {
        "name": "pg-data",
        "spec": {
          "size": "5Gi",
          "access_mode": "ReadWriteOnce",
          "needs_sync_before_use": false
        }
      }
    ],
    "connections": [
      {
        "kind": "env",
        "from": {
          "type": "stack_resource",
          "name": "postgres"
        },
        "to": {
          "type": "stack_resource",
          "name": "tooljet"
        },
        "mappings": [
          {
            "target": {
              "type": "env",
              "name": "PG_HOST"
            },
            "value": {
              "output": "host"
            }
          },
          {
            "target": {
              "type": "env",
              "name": "TOOLJET_DB_HOST"
            },
            "value": {
              "output": "host"
            }
          },
          {
            "target": {
              "type": "env",
              "name": "PGRST_DB_URI"
            },
            "value": {
              "template": "postgres://tooljet:tooljet_password@{{ host }}:5432/tooljet_db",
              "values": {
                "host": {
                  "output": "host"
                }
              }
            }
          }
        ]
      },
      {
        "kind": "env",
        "from": {
          "type": "stack_resource",
          "name": "mailhog"
        },
        "to": {
          "type": "stack_resource",
          "name": "tooljet"
        },
        "mappings": [
          {
            "target": {
              "type": "env",
              "name": "SMTP_DOMAIN"
            },
            "value": {
              "output": "host"
            }
          }
        ]
      },
      {
        "kind": "volume_mount",
        "from": {
          "type": "volume",
          "name": "pg-data"
        },
        "to": {
          "type": "stack_resource",
          "name": "postgres"
        },
        "config": {
          "mount_path": "/var/lib/postgresql/data"
        }
      }
    ]
  }
}
