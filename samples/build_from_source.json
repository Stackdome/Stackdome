{
  "name": "test-build",
  "labels": [
    {
      "key": "app",
      "value": "test-build"
    }
  ],
  "spec": {
    "stack_resources": [
      {
        "name": "web",
        "ports": [
          {
            "name": "http",
            "number": 3000,
            "exposed_to_public": true,
            "subdomain_prefix": "test-build",
            "protocol": "HTTP"
          }
        ],
        "source": {
          "git": {
            "repo_url": "https://github.com/Stackdome/test-repo.git",
            "branch": {
              "name": "main"
            },
            "dockerfile_path": "docker/Dockerfile.prod",
            "build_context": "."
          }
        }
      }
    ]
  }
}
