{
    "name": "tooljet-addon",
    "labels": [
        {
            "key": "app",
            "value": "tooljet"
        }
    ],
    "spec": {
        "stack_resources": [
            {
                "name": "tooljet",
                "image_spec": {
                    "image": "tooljet/tooljet-ce:latest"
                },
                "ports": [
                    {
                        "number": 80,
                        "exposed_to_public": true,
                        "subdomain_prefix": "tooljet",
                        "protocol": "HTTP"
                    }
                ],
                "execution_config": {
                    "args": ["npm", "run", "start:prod"],
                    "environment_variables": [
                        {
                            "name": "NODE_ENV",
                            "value": "production"
                        },
                        {
                            "name": "PORT",
                            "value": "80"
                        },
                        {
                            "name": "TOOLJET_HOST",
                            "value": "https://{{STACKDOME_TOOLJET_PUBLIC}}"
                        },
                        {
                            "name": "LOCKBOX_MASTER_KEY",
                            "value": "db78c1536f072aa1607a89f3d29541134d132467f31579a51143f56b4ac84214"
                        },
                        {
                            "name": "SECRET_KEY_BASE",
                            "value": "0622a64434a91c4fefbd9658ff2212a43da7819ab153cc6b469de1275baba71a"
                        },
                        {
                            "name": "ENABLE_TOOLJET_DB",
                            "value": "true"
                        },
                        {
                            "name": "PGRST_HOST",
                            "value": "localhost:3001"
                        },
                        {
                            "name": "PGRST_SERVER_PORT",
                            "value": "3001"
                        },
                        {
                            "name": "PGRST_JWT_SECRET",
                            "value": "0622a64434a91c4fefbd9658ff2212a43da7819ab153cc6b469de1275baba71a"
                        },
                        {
                            "name": "SMTP_DOMAIN",
                            "value": "{{STACKDOME_MAILHOG_INTERNAL}}"
                        },
                        {
                            "name": "SMTP_PORT",
                            "value": "1025"
                        },
                        {
                            "name": "SMTP_USERNAME",
                            "value": "user"
                        },
                        {
                            "name": "SMTP_PASSWORD",
                            "value": "password"
                        },
                        {
                            "name": "DEFAULT_FROM_EMAIL",
                            "value": "tooljet@local.stackdome.io"
                        },
                        {
                            "name": "PG_DB_OWNER",
                            "value": "false"
                        }
                    ],
                    "env_from_addons": [
                        {
                            "postgres": {
                                "addon_id": "<POSTGRES_ADDON_ID>",
                                "database": "tooljet",
                                "env_mapping": {
                                    "host": "PG_HOST",
                                    "port": "PG_PORT",
                                    "username": "PG_USER",
                                    "password": "PG_PASS",
                                    "database": "PG_DB"
                                }
                            }
                        },
                        {
                            "postgres": {
                                "addon_id": "<POSTGRES_ADDON_ID>",
                                "database": "tooljet-db",
                                "env_mapping": {
                                    "host": "TOOLJET_DB_HOST",
                                    "username": "TOOLJET_DB_USER",
                                    "password": "TOOLJET_DB_PASS",
                                    "database": "TOOLJET_DB",
                                    "connectionString": "PGRST_DB_URI"
                                }
                            }
                        }
                    ]
                },
                "depends_on": ["redis"]
            },
            {
                "name": "redis",
                "image_spec": {
                    "image": "redis:6.2"
                },
                "ports": [
                    {
                        "number": 6379,
                        "exposed_to_public": false,
                        "protocol": "TCP"
                    }
                ]
            },
            {
                "name": "mailhog",
                "image_spec": {
                    "image": "mailhog/mailhog"
                },
                "ports": [
                    {
                        "number": 1025,
                        "exposed_to_public": false,
                        "protocol": "TCP"
                    },
                    {
                        "number": 8025,
                        "exposed_to_public": true,
                        "subdomain_prefix": "mail",
                        "protocol": "HTTP"
                    }
                ]
            }
        ]
    }
}
