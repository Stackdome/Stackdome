{
    "name": "tooljet-addon",
    "labels": [
        { "key": "app", "value": "tooljet" }
    ],
    "spec": {
        "stack_resources": [
            {
                "name": "tooljet",
                "image_spec": { "image": "tooljet/tooljet-ce:latest" },
                "ports": [
                    { "name": "http", "number": 80, "exposed_to_public": true, "subdomain_prefix": "tooljet", "protocol": "HTTP" }
                ],
                "execution_config": {
                    "args": ["npm", "run", "start:prod"],
                    "environment_variables": [
                        { "name": "NODE_ENV", "value": "production" },
                        { "name": "PORT", "value": "80" },
                        { "name": "LOCKBOX_MASTER_KEY", "value": "db78c1536f072aa1607a89f3d29541134d132467f31579a51143f56b4ac84214" },
                        { "name": "SECRET_KEY_BASE", "value": "0622a64434a91c4fefbd9658ff2212a43da7819ab153cc6b469de1275baba71a" },
                        { "name": "ENABLE_TOOLJET_DB", "value": "true" },
                        { "name": "PGRST_HOST", "value": "localhost:3001" },
                        { "name": "PGRST_SERVER_PORT", "value": "3001" },
                        { "name": "PGRST_JWT_SECRET", "value": "0622a64434a91c4fefbd9658ff2212a43da7819ab153cc6b469de1275baba71a" },
                        { "name": "SMTP_PORT", "value": "1025" },
                        { "name": "SMTP_USERNAME", "value": "user" },
                        { "name": "SMTP_PASSWORD", "value": "password" },
                        { "name": "DEFAULT_FROM_EMAIL", "value": "tooljet@local.stackdome.io" },
                        { "name": "PG_DB_OWNER", "value": "false" },
                        { "name": "TOOLJET_HOST", "self_output": "public.http.url" }
                    ]
                },
                "depends_on": ["redis"]
            },
            {
                "name": "redis",
                "image_spec": { "image": "redis:6.2" },
                "ports": [
                    { "name": "redis", "number": 6379, "exposed_to_public": false, "protocol": "TCP" }
                ]
            },
            {
                "name": "mailhog",
                "image_spec": { "image": "mailhog/mailhog" },
                "ports": [
                    { "name": "smtp", "number": 1025, "exposed_to_public": false, "protocol": "TCP" },
                    { "name": "http", "number": 8025, "exposed_to_public": true, "subdomain_prefix": "mail", "protocol": "HTTP" }
                ]
            }
        ],
        "connections": [
            {
                "kind": "env",
                "from": { "type": "addon/postgres", "id": "<POSTGRES_ADDON_ID>" },
                "to": { "type": "stack_resource", "name": "tooljet" },
                "config": { "database": "tooljet" },
                "mappings": [
                    { "target": { "type": "env", "name": "PG_HOST" }, "value": { "output": "host" } },
                    { "target": { "type": "env", "name": "PG_PORT" }, "value": { "output": "port" } },
                    { "target": { "type": "env", "name": "PG_USER" }, "value": { "output": "username" } },
                    { "target": { "type": "env", "name": "PG_PASS" }, "value": { "output": "password" } },
                    { "target": { "type": "env", "name": "PG_DB" }, "value": { "output": "database" } },
                    { "target": { "type": "env", "name": "TOOLJET_DB_HOST" }, "value": { "output": "host" } },
                    { "target": { "type": "env", "name": "TOOLJET_DB_USER" }, "value": { "output": "username" } },
                    { "target": { "type": "env", "name": "TOOLJET_DB_PASS" }, "value": { "output": "password" } },
                    { "target": { "type": "env", "name": "TOOLJET_DB" }, "value": { "output": "database" } },
                    { "target": { "type": "env", "name": "PGRST_DB_URI" }, "value": { "output": "url" } }
                ]
            },
            {
                "kind": "env",
                "from": { "type": "stack_resource", "name": "mailhog" },
                "to": { "type": "stack_resource", "name": "tooljet" },
                "mappings": [
                    { "target": { "type": "env", "name": "SMTP_DOMAIN" }, "value": { "output": "host" } }
                ]
            }
        ]
    }
}
