{
    "name": "tooljet-build",
    "labels": [
        { "key": "app", "value": "tooljet" }
    ],
    "spec": {
        "stack_resources": [
            {
                "name": "tooljet",
                "build_spec": {
                    "context_path_within_source": "/",
                    "dockerfile_path": "/docker/ce-production.Dockerfile",
                    "image_repository": { "use_internal_registry": true },
                    "source_context": {
                        "git_repo": { "repo_url": "https://github.com/ToolJet/ToolJet.git" }
                    },
                    "source_revision": {
                        "git_repo_revision": { "branch": { "name": "main" } }
                    }
                },
                "ports": [
                    { "name": "http", "number": 80, "exposed_to_public": true, "subdomain_prefix": "tooljet", "protocol": "HTTP" }
                ],
                "execution_config": {
                    "environment_variables": [
                        { "name": "NODE_ENV", "value": "production" },
                        { "name": "PORT", "value": "80" },
                        { "name": "LOCKBOX_MASTER_KEY", "value": "db78c1536f072aa1607a89f3d29541134d132467f31579a51143f56b4ac84214" },
                        { "name": "SECRET_KEY_BASE", "value": "0622a64434a91c4fefbd9658ff2212a43da7819ab153cc6b469de1275baba71a" },
                        { "name": "PG_PORT", "value": "5432" },
                        { "name": "PG_USER", "value": "tooljet" },
                        { "name": "PG_PASS", "value": "tooljet_password" },
                        { "name": "PG_DB", "value": "tooljet" },
                        { "name": "ENABLE_TOOLJET_DB", "value": "true" },
                        { "name": "TOOLJET_DB", "value": "tooljet_db" },
                        { "name": "TOOLJET_DB_USER", "value": "tooljet" },
                        { "name": "TOOLJET_DB_PASS", "value": "tooljet_password" },
                        { "name": "PGRST_HOST", "value": "localhost:3001" },
                        { "name": "PGRST_SERVER_PORT", "value": "3001" },
                        { "name": "PGRST_JWT_SECRET", "value": "0622a64434a91c4fefbd9658ff2212a43da7819ab153cc6b469de1275baba71a" },
                        { "name": "TOOLJET_HOST", "self_output": "public.http.url" }
                    ]
                },
                "depends_on": ["postgres", "redis"]
            },
            {
                "name": "postgres",
                "image_spec": { "image": "postgres:13" },
                "stateful": true,
                "ports": [
                    { "name": "postgres", "number": 5432, "exposed_to_public": false, "protocol": "TCP" }
                ],
                "execution_config": {
                    "environment_variables": [
                        { "name": "POSTGRES_USER", "value": "tooljet" },
                        { "name": "POSTGRES_PASSWORD", "value": "tooljet_password" },
                        { "name": "POSTGRES_DB", "value": "tooljet" }
                    ]
                }
            },
            {
                "name": "redis",
                "image_spec": { "image": "redis:6.2" },
                "ports": [
                    { "name": "redis", "number": 6379, "exposed_to_public": false, "protocol": "TCP" }
                ]
            }
        ],
        "volumes": [
            {
                "name": "pg-data",
                "spec": { "size": "5Gi", "access_mode": "ReadWriteOnce", "needs_sync_before_use": false }
            }
        ],
        "connections": [
            {
                "kind": "env",
                "from": { "type": "stack_resource", "name": "postgres" },
                "to": { "type": "stack_resource", "name": "tooljet" },
                "mappings": [
                    { "target": { "type": "env", "name": "PG_HOST" }, "value": { "output": "host" } },
                    { "target": { "type": "env", "name": "TOOLJET_DB_HOST" }, "value": { "output": "host" } },
                    {
                        "target": { "type": "env", "name": "PGRST_DB_URI" },
                        "value": {
                            "template": "postgres://tooljet:tooljet_password@{{ host }}:5432/tooljet_db",
                            "values": { "host": { "output": "host" } }
                        }
                    }
                ]
            },
            {
                "kind": "volume_mount",
                "from": { "type": "volume", "name": "pg-data" },
                "to": { "type": "stack_resource", "name": "postgres" },
                "config": { "mount_path": "/var/lib/postgresql/data" }
            }
        ]
    }
}
