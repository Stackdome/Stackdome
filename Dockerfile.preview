FROM node:22-alpine AS frontend

RUN corepack enable pnpm && corepack prepare pnpm@10.33.2 --activate

WORKDIR /app/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm exec vite build --outDir ../pkg/web/dist

FROM golang:1.25-alpine AS backend

RUN apk add --no-cache git

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=frontend /app/pkg/web/dist pkg/web/dist
RUN CGO_ENABLED=0 go build -o stackdome-server cmd/main.go

FROM alpine:3.21.3

RUN apk add --no-cache ca-certificates

WORKDIR /app
COPY --from=backend /app/stackdome-server .

USER 65532:65532

EXPOSE 8000

ENTRYPOINT ["./stackdome-server"]
CMD ["serve"]
