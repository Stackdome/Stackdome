# IDEs
.idea
.vscode

# Node compile cache (build artifact, never commit)
node-compile-cache/

# Integration test cache (clusters, kubeconfigs, CI logs — never commit)
test/int/.cache/
cluster_config.yaml
database.yaml
bin/
dev_env.yaml

.superpowers/
.worktrees/
docs/superpowers/

# Internal engineering notes (specs, plans, guides). Product docs live in docs/.
dev-docs/

# Vite output. .gitkeep tracked so //go:embed succeeds before first build.
pkg/web/dist/*
!pkg/web/dist/.gitkeep

# Local secrets
.env
.env.local
.env.*.local

# Local dev artifacts (Playwright session output, ad-hoc screenshots)
.playwright-mcp/
*.png
!frontend/**/*.png
# Published docs screenshots — these ARE the site's images and must be committed.
!docs/images/**/*.png
# Docs favicons, copied from frontend/public — same reason.
!docs/favicon-*.png
.vite/

# Integration test output (Makefile tees here)
test/int/last-run.log
.pnpm-store
